        </mxCell>

        <mxCell id="subtitle" value="One GenericAdapter reads ProviderProfile flags. Adding a provider = one data constant." style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontFamily=Lato;align=center;fontColor=#666666;" vertex="1" parent="1">
